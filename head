    if (window.swiperFactory) {
      clearInterval(interval);

      let swiperInstances = [];
      let previousIsMobile = null;

      function initSwiper() {
        document.querySelectorAll('.inserti-home-swiper .swiper-container:not(.swiper-activated)').forEach(swiper_element => {
          const rel = swiper_element.getAttribute('data-ref');

          const swiper = swiperFactory(
            `.swiper-container[data-ref="${rel}"]`,
            {
              centeredSlides: true,
              slidesPerView: "auto",
              spaceBetween: 30,
              navigation: {
                nextEl: `.swiper-button-next`,
                prevEl: `.swiper-button-prev`,
              },
            }
          );

          swiperInstances.push(swiper);

          swiper_element.classList.add('swiper-activated');
        });

      }

      if (document.readyState === 'loading') {
        // Il DOM non è ancora caricato, quindi aspettiamo l'evento
        document.addEventListener('DOMContentLoaded', initSwiper);
      } else {
        // Il DOM è già pronto, esegui subito
        initSwiper();
      }
    }
