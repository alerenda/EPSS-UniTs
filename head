  const timeout_ms = 5000;
  let tries = 0;
  let ping_duration_ms = 3000;

  const interval = setInterval(() => {
    if (tries * interval_ms > timeout_ms) {
      clearInterval(interval);
      //console.error('ESCO')
      return;
    }
    if (typeof window.swiperFactory === 'undefined') {
      tries++;
      //console.error('RIPROVO')
      return;
